# Telegram bot (from @BotFather) and destination chat id
TELEGRAM_BOT_TOKEN=8816446322:AAE7B0sDonnJikK6eajc9jt2qqzOpYZg5NA
TELEGRAM_CHAT_ID=8684965873

# Alert thresholds (demo defaults — calibrate for your real sensors)
TEMP_THRESHOLD=50
HUMIDITY_THRESHOLD=20
SMOKE_THRESHOLD=2300

# Local port (Render provides PORT automatically in production)
PORT=10000
